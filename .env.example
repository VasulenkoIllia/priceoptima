# PriceOptima на сервері (Docker + Traefik: мережа proxy, entrypoint websecure, certresolver cf).
APP_NAME=priceoptima
APP_DOMAIN=priceoptima.example.com
TZ=Europe/Kyiv

# ── база даних ──────────────────────────────────────────────────────
POSTGRES_USER=priceoptima
POSTGRES_PASSWORD=
POSTGRES_DB=priceoptima
# порт бази на самому сервері (назовні не відкривається)
POSTGRES_PORT=5433
# host=db — це назва сусіднього контейнера; локально без docker: 127.0.0.1:5433
DATABASE_URL=postgresql://priceoptima:ЗМІНІТЬ_ПАРОЛЬ@db:5432/priceoptima?schema=public
# пам'ять Postgres (типово — під сервер 8 ГБ); сервер 4 ГБ: 1GB і 2GB, сервер 16 ГБ: 4GB і 10GB
# PG_SHARED_BUFFERS=2GB
# PG_EFFECTIVE_CACHE=5GB
# межа одного запиту, «забутої» транзакції й поріг запису повільних запитів у лог бази (мс)
# PG_STATEMENT_TIMEOUT=120s
# PG_IDLE_IN_TX_TIMEOUT=60s
# PG_LOG_SLOW=1000

# ── застосунок ──────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
# пам'ять Node (типово 3 ГБ — під великі вигрузки прайсів); сервер 4 ГБ: --max-old-space-size=1536
# NODE_OPTIONS=--max-old-space-size=3072
# межа пам'яті контейнера застосунку (має бути більшою за купу Node); сервер 4 ГБ: 2g
# APP_MEM_LIMIT=4g
# ключ підпису cookie сесії, ≥16 символів: openssl rand -base64 32
SESSION_SECRET=
# скільки днів живе вхід без активності
SESSION_TTL_DAYS=30
# cookie входу лише через HTTPS (за замовчуванням так у production); 0 — лише для перевірки збірки на http://localhost
# COOKIE_SECURE=0
# тека завантажених файлів (фото товарів); за замовчуванням — data/uploads поряд із застосунком,
# у docker це том ./data/uploads з docker-compose.yml
# UPLOADS_DIR=/app/data/uploads

# ── перший адміністратор (створюється сідом при старті, далі не змінюється) ──
# перший адміністратор: створюється один раз, при першому вході задає власний пароль; решту користувачів він запрошує посиланням
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Адміністратор
ADMIN_SHORT_NAME=Адмін.

# ── резервні копії (контейнер backup) ──────────────────────────────
# розклад cron за TZ: щодня о 02:30
# BACKUP_CRON=30 2 * * *
# копія поза сервер: назва remote з data/rclone/rclone.conf і тека, напр. storagebox:priceoptima
# BACKUP_REMOTE=
