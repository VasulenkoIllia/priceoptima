# PriceOptima на сервері (Docker + Traefik: мережа proxy, entrypoint websecure, certresolver cf).
APP_NAME=priceoptima
APP_DOMAIN=priceoptima.example.com
TZ=Europe/Kyiv

# ── база даних ──────────────────────────────────────────────────────
POSTGRES_USER=priceoptima
POSTGRES_PASSWORD=
POSTGRES_DB=priceoptima
# порт бази на самому сервері (назовні не відкривається)
POSTGRES_PORT=5433
# host=db — це назва сусіднього контейнера; локально без docker: 127.0.0.1:5433
DATABASE_URL=postgresql://priceoptima:ЗМІНІТЬ_ПАРОЛЬ@db:5432/priceoptima?schema=public

# ── застосунок ──────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
# ключ підпису cookie сесії, ≥16 символів: openssl rand -base64 32
SESSION_SECRET=
# скільки днів живе вхід без активності
SESSION_TTL_DAYS=30
# cookie входу лише через HTTPS (за замовчуванням так у production); 0 — лише для перевірки збірки на http://localhost
# COOKIE_SECURE=0
# тека завантажених файлів (фото товарів); за замовчуванням — data/uploads поряд із застосунком,
# у docker це том ./data/uploads з docker-compose.yml
# UPLOADS_DIR=/app/data/uploads

# ── перший адміністратор (створюється сідом при старті, далі не змінюється) ──
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Адміністратор
ADMIN_SHORT_NAME=Адмін.
