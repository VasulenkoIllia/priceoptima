# PriceOptima — прототип на сервері (Docker + Traefik: мережа proxy, entrypoint websecure, certresolver cf).
APP_NAME=priceoptima
APP_DOMAIN=priceoptima.example.com
TZ=Europe/Kyiv

# Вхід у прототип (один обліковий запис). Тут лише логін і SHA-256 пароля — сам пароль ніде не зберігається:
#   printf '%s' 'ваш-пароль' | sha256sum
AUTH_LOGIN=admin
AUTH_PASSWORD_SHA256=
