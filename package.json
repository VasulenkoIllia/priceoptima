{
  "name": "priceoptima",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "tsc -p tsconfig.json --noEmit && vite build",
    "build:server": "tsc -p tsconfig.server.json --noEmit && node scripts/build-server.mjs",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "preview": "vite preview",
    "db:generate": "prisma generate --schema server/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema server/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema server/prisma/schema.prisma",
    "db:seed": "tsx --env-file-if-exists=.env server/prisma/seed.ts",
    "db:studio": "prisma studio --schema server/prisma/schema.prisma",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate --schema server/prisma/schema.prisma"
  },
  "dependencies": {
    "@ag-grid-community/locale": "36.1.0",
    "@ant-design/icons": "5.6.1",
    "@ant-design/v5-patch-for-react-19": "1.0.3",
    "@e965/xlsx": "0.20.3",
    "@node-rs/argon2": "2.2.1",
    "@prisma/client": "6.19.3",
    "@tanstack/react-query": "5.102.8",
    "ag-grid-community": "36.1.0",
    "ag-grid-react": "36.1.0",
    "antd": "5.29.3",
    "compression": "1.8.2",
    "cookie-parser": "1.4.7",
    "dayjs": "1.11.23",
    "exceljs": "4.4.0",
    "express": "5.2.1",
    "fast-xml-parser": "5.11.1",
    "immer": "11.1.18",
    "multer": "2.4.0",
    "pdfmake": "0.3.11",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "prisma": "6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.3",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.2.0",
    "@types/node": "22.20.2",
    "@types/pdfmake": "0.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "jsdom": "30.0.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
