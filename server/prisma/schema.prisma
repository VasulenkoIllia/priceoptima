// Схема бази для модуля 1 (каркас, довідники, каталог, прайси). Заявки й КП — окремою міграцією в модулі 2.
// Гроші — Decimal(14,4): ціни зберігаємо у валюті прайсу без округлення до копійок, округлення робить рушій shared/pricing.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  user
}

enum RequestStatus {
  in_progress
  done
  cancelled
}

/// Разове посилання: запрошення нового користувача або скидання пароля.
enum AccessLinkKind {
  invite
  reset
}

enum Currency {
  UAH
  USD
  EUR
}

enum Availability {
  in_stock
  low_stock
  out_of_stock
  on_order
  unknown
}

/// Звідки востаннє взялася ціна товару.
enum PriceOrigin {
  import
  manual
}

enum RatePolicy {
  price_list
  manual
  nbu
  nbu_adjusted
}

enum RateSource {
  nbu
  manual
  price_list
}

/// auto — усе з посилання; manual — усе з файлу; hybrid — асортимент, наявність і описи з посилання, ціни — з файлу.
enum PriceFeedKind {
  auto
  manual
  hybrid
}

enum FeedAuth {
  none
  bearer
  basic
  query
}

enum ImportRunSource {
  auto
  file
}

/// Фото з прайсу (посилання) або завантажене нами (лежить у сховищі).
enum ImageSource {
  feed
  upload
}

enum ImportRunStatus {
  ok
  error
}

// ── користувачі й налаштування ──────────────────────────────────────

model User {
  id                 String    @id @default(uuid())
  login              String    @unique
  passwordHash       String?
  fullName           String
  shortName          String
  role               UserRole  @default(user)
  email              String?
  phone              String?
  isActive           Boolean   @default(true)
  /// Коли заблоковано (isActive = false).
  blockedAt          DateTime?
  /// Перший вхід адміністратора з .env — спершу змінити пароль (РОЛ-2).
  mustChangePassword Boolean   @default(false)
  /// Хто запросив (null — перший адміністратор із .env).
  createdById        String?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions     Session[]
  importRuns   PriceImportRun[]
  priceHistory PriceHistory[]
  clients      Client[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ip        String?

  @@index([userId])
  @@index([expiresAt])
}

/// Один рядок на систему. Набір полів — рівно як у типі AppSettings (shared/types/users.ts).
/// Поля-перелічення тримаємо рядками: значення перевіряє zod на вході в API, міграція при зміні списку не потрібна.
model AppSettings {
  id                          Int      @id @default(1)
  vatRatePct                  Decimal  @default(20) @db.Decimal(5, 2)
  priceStaleDays              Int      @default(7)
  priceListRateMaxAgeDays     Int      @default(3)
  lockTtlSeconds              Int      @default(180)
  lockHeartbeatSeconds        Int      @default(20)
  autosaveDebounceMs          Int      @default(800)
  defaultMarkupMethod         String   @default("rrp")
  defaultMarkupValue          Decimal  @default(0) @db.Decimal(6, 3)
  priceRounding               String   @default("kopecks")
  discountFormula             String   @default("percent_off")
  autoRoundMultiplicity       Boolean  @default(true)
  excludeUnavailableByDefault Boolean  @default(false)
  kpDefaultVatMode            String   @default("without_vat")
  kpNameSource                String   @default("work")
  kpShowImages                Boolean  @default(false)
  kpValidityDays              Int      @default(3)
  /// Типові умови КП [{label, value}]; null — вбудовані типові (Умови поставки, Термін, Оплата, Гарантія).
  kpTerms                     Json?
  fopPriceBasis               String   @default("gross")
  nextRequestNumber           Int      @default(1)
  nextKpNumber                Int      @default(2114)
  updatedAt                   DateTime @updatedAt
  updatedById                 String?
}

model OwnCompany {
  id           String   @id @default(uuid())
  /// Лічильник змін картки: зберігаємо лише з тією версією, яку відкрив користувач (ДОВ-6).
  version      Int      @default(1)
  /// Коротка позначка юрособи в інтерфейсі ('ТОВ', 'ФОП').
  code         String   @default("")
  nameShort    String
  nameFull     String?
  brandName    String?
  edrpou       String?
  ipn          String?
  isVatPayer   Boolean  @default(true)
  iban         String?
  bankName     String?
  addressLegal String?
  phone        String?
  email        String?
  website      String?
  slogan       String?
  logoUrl      String?
  kpFooter     String?
  isDefault    Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdById  String?
  updatedById  String?
}

// ── постачальники ───────────────────────────────────────────────────

model Supplier {
  id                String     @id @default(uuid())
  /// Лічильник змін картки: зберігаємо лише з тією версією, яку відкрив користувач (ДОВ-6).
  version           Int        @default(1)
  name              String
  color             String?
  logoUrl           String?
  defaultCurrency   Currency   @default(UAH)
  /// Ціни в прайсі з ПДВ (нормалізуємо до входу без ПДВ при завантаженні).
  pricesIncludeVat  Boolean    @default(false)
  rrpIncludesVat    Boolean    @default(true)
  supplierMarkupPct Decimal    @default(0) @db.Decimal(6, 3)
  ratePolicy        RatePolicy @default(price_list)
  rateAdjustPct     Decimal    @default(0) @db.Decimal(6, 3)
  manualRateUsd     Decimal?   @db.Decimal(12, 4)
  manualRateEur     Decimal?   @db.Decimal(12, 4)
  manualRatesDate   DateTime?  @db.Date
  priceListRateUsd  Decimal?   @db.Decimal(12, 4)
  priceListRateEur  Decimal?   @db.Decimal(12, 4)
  priceListRateDate DateTime?  @db.Date
  minOrderAmount    Decimal?   @db.Decimal(14, 2)
  priceStaleDays    Int?
  searchUrlTemplate String?
  website           String?
  b2bUrl            String?
  notes             String?
  deliveryInfo      String?
  isActive          Boolean    @default(true)
  sortOrder         Int        @default(0)
  lastImportAt      DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  createdById       String?
  updatedById       String?

  feed          SupplierPriceFeed?
  legalEntities SupplierLegalEntity[]
  contacts      SupplierContact[]
  products      Product[]
  importRuns    PriceImportRun[]

  @@index([isActive, sortOrder])
}

/// Джерело прайсу. URL і секрет назовні не віддаємо — в API лише хост і стан.
model SupplierPriceFeed {
  supplierId       String        @id
  supplier         Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  kind             PriceFeedKind @default(manual)
  /// Модуль вигрузки постачальника (shared/catalog/connectors): sandi, sanwell, yml.
  connector        String?
  url              String?
  auth             FeedAuth      @default(none)
  /// Токен або пароль (шифрується перед записом).
  secret           String?
  /// Година щоденного запуску, 0–23.
  scheduleHour     Int?
  hasPurchasePrice Boolean       @default(true)
  /// Зіставлення колонок для файлових прайсів (як у діалозі завантаження).
  columnMapping    Json?
  note             String?
  lastError        String?
  lastErrorAt      DateTime?
  failCount        Int           @default(0)
  updatedAt        DateTime      @updatedAt
}

model SupplierLegalEntity {
  id         String   @id @default(uuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  nameShort  String
  nameFull   String?
  edrpou     String?
  ipn        String?
  isVatPayer Boolean  @default(true)
  iban       String?
  bankName   String?
  address    String?
  note       String?
  isDefault  Boolean  @default(false)
  isActive   Boolean  @default(true)

  @@index([supplierId])
}

model SupplierContact {
  id         String   @id @default(uuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  fullName   String
  position   String?
  phone      String?
  email      String?
  note       String?

  @@index([supplierId])
}

// ── клієнти ─────────────────────────────────────────────────────────

model Client {
  id                String          @id @default(uuid())
  /// Лічильник змін картки: зберігаємо лише з тією версією, яку відкрив користувач (ДОВ-6).
  version           Int             @default(1)
  name              String
  notes             String?
  responsibleUserId String?
  responsibleUser   User?           @relation(fields: [responsibleUserId], references: [id])
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  createdById       String?
  updatedById       String?
  counterparties    Counterparty[]
  contacts          ClientContact[]

  @@index([name])
}

model Counterparty {
  id            String          @id @default(uuid())
  clientId      String
  client        Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  nameShort     String
  nameFull      String?
  edrpou        String?
  ipn           String?
  isVatPayer    Boolean         @default(true)
  legalAddress  String?
  actualAddress String?
  note          String?
  isDefault     Boolean         @default(false)
  isActive      Boolean         @default(true)
  contacts      ClientContact[]

  @@index([clientId])
  @@index([edrpou])
}

/// Контакт клієнта. Прив'язка до юрособи необов'язкова: буває спільна для клієнта людина.
model ClientContact {
  id             String        @id @default(uuid())
  clientId       String
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  counterpartyId String?
  counterparty   Counterparty? @relation(fields: [counterpartyId], references: [id], onDelete: SetNull)
  fullName       String
  position       String?
  phone          String?
  email          String?
  note           String?
  isDefault      Boolean       @default(false)
  isActive       Boolean       @default(true)

  @@index([clientId])
  @@index([counterpartyId])
}

// ── довідники ───────────────────────────────────────────────────────

model Unit {
  code      String   @id
  name      String
  /// Синоніми для розпізнавання при імпорті позицій клієнта.
  aliases   String[]
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
}

model CurrencyRate {
  id          Int        @id @default(autoincrement())
  currency    Currency
  rateDate    DateTime   @db.Date
  rate        Decimal    @db.Decimal(12, 4)
  source      RateSource
  fetchedAt   DateTime   @default(now())
  note        String?
  /// Хто ввів ручний курс.
  createdById String?

  @@unique([currency, rateDate, source])
  @@index([rateDate])
}

// ── каталог ─────────────────────────────────────────────────────────

model Product {
  id             String       @id @default(uuid())
  /// Лічильник змін картки: зберігаємо лише з тією версією, яку відкрив користувач (ДОВ-6).
  version        Int          @default(1)
  supplierId     String
  supplier       Supplier     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  /// Код постачальника як у прайсі.
  sku            String
  /// normalizeSku(sku) — за ним звіряємо прайс.
  skuKey         String
  nameWork       String
  /// Назва як у бухгалтерії клієнта (для КП і зіставлення).
  name1c         String?
  /// buildSearchText(sku, назви, бренд) — за ним шукає каталог (GIN pg_trgm).
  searchText     String       @default("")
  brand          String?
  unitCode       String       @default("шт")
  currency       Currency     @default(UAH)
  /// Вхід без ПДВ у валюті прайсу.
  purchasePrice  Decimal?     @db.Decimal(14, 4)
  /// РРЦ з ПДВ у валюті прайсу.
  rrp            Decimal?     @db.Decimal(14, 4)
  multiplicity   Decimal      @default(1) @db.Decimal(12, 3)
  minOrderQty    Decimal?     @db.Decimal(12, 3)
  stockQty       Decimal?     @db.Decimal(12, 3)
  availability   Availability @default(unknown)
  barcode        String?
  categoryPath   String?
  imageUrl       String?
  productUrl     String?
  notes          String?
  priceOrigin    PriceOrigin  @default(import)
  priceUpdatedAt DateTime?
  /// Немає у прайсі з цієї дати (ціна лишається останньою відомою).
  missingSince   DateTime?    @db.Date
  isArchived     Boolean      @default(false)
  /// Коли товар прибрано в архів автоматично (немає у прайсі понад 30 днів). Архів вручну цю дату не ставить —
  /// тож повернути з архіву, коли позиція знову з'явиться у прайсі, можна лише такий товар.
  autoArchivedAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  /// Хто додав вручну / востаннє змінив картку (прайс — у журналі оновлень).
  createdById    String?
  updatedById    String?

  priceHistory PriceHistory[]
  images       ProductImage[]

  @@unique([supplierId, skuKey])
  /// Каталог одного постачальника за назвою: сторінка береться прямо з індексу, без сортування всіх позицій.
  @@index([supplierId, isArchived, nameWork, id])
  /// сортування всієї номенклатури за артикулом, назвою й ціною входу (CATALOG_SORT_ANYTIME)
  @@index([sku, id])
  @@index([nameWork, id])
  @@index([purchasePrice])
  @@index([missingSince])
  /// Точний артикул по всьому каталогу (без фільтра за постачальником).
  @@index([skuKey])
  /// Артикул за префіксом: LIKE 'АБВ%' бере індекс незалежно від collation бази.
  @@index([skuKey(ops: raw("text_pattern_ops"))], map: "Product_skuKey_prefix_idx")
  /// Пошук за назвою: LIKE '%токен%' по нормалізованому тексту.
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
  /// Артикул «містить» у номенклатурі: без цього індексу пошук за кодом переглядав увесь каталог.
  @@index([skuKey(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_skuKey_trgm_idx")
}

/// Фото товару: з прайсу — посилання, наші — файл у сховищі. Головне фото йде в КП і в списки.
model ProductImage {
  id         String      @id @default(uuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  source     ImageSource
  /// Посилання з прайсу (source = feed).
  url        String?
  /// Шлях у сховищі (source = upload).
  storedPath String?
  fileName   String?
  mimeType   String?
  sizeBytes  Int?
  width      Int?
  height     Int?
  isMain     Boolean     @default(false)
  sortOrder  Int         @default(0)
  uploadedBy String?
  createdAt  DateTime    @default(now())

  @@index([productId, sortOrder])
}

model PriceHistory {
  id            Int             @id @default(autoincrement())
  productId     String
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  effectiveAt   DateTime        @default(now())
  currency      Currency
  purchasePrice Decimal?        @db.Decimal(14, 4)
  rrp           Decimal?        @db.Decimal(14, 4)
  stockQty      Decimal?        @db.Decimal(12, 3)
  availability  Availability?
  origin        PriceOrigin
  importRunId   Int?
  importRun     PriceImportRun? @relation(fields: [importRunId], references: [id])
  userId        String?
  user          User?           @relation(fields: [userId], references: [id])
  note          String?

  @@index([productId, effectiveAt])
  @@index([importRunId])
}

// ── оновлення прайсів ───────────────────────────────────────────────

model PriceImportRun {
  id            Int              @id @default(autoincrement())
  supplierId    String
  supplier      Supplier         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  startedAt     DateTime         @default(now())
  finishedAt    DateTime?
  source        ImportRunSource
  status        ImportRunStatus  @default(ok)
  fileId        String?
  file          PriceImportFile? @relation(fields: [fileId], references: [id])
  /// Назва файлу прайсу (рядки з браузера приходять без самого файлу).
  fileName      String?
  productsTotal Int              @default(0)
  added         Int              @default(0)
  changed       Int              @default(0)
  priceUp       Int              @default(0)
  priceDown     Int              @default(0)
  stockChanged  Int              @default(0)
  missing       Int              @default(0)
  skipped       Int              @default(0)
  /// Знайдено за штрихкодом або артикулом — код товару замінено кодом із прайсу.
  relinked      Int              @default(0)
  /// Повернуто з архіву: позиція знову є у прайсі.
  restored      Int              @default(0)
  /// Товарів, у яких заповнений опис відрізняється від прайсу (опис не змінено).
  detailsDiffer Int              @default(0)
  rateUsd       Decimal?         @db.Decimal(12, 4)
  rateEur       Decimal?         @db.Decimal(12, 4)
  errorText     String?
  /// Попередження розбору прайсу, по одному на рядок (немає цін, пропущені рядки тощо).
  warnings      String?
  /// Звіт звірки: приклади відмінностей описів, великих змін цін, перечеплених кодів, ненайдених і пропущених рядків.
  details       Json?
  userId        String?
  user          User?            @relation(fields: [userId], references: [id])

  priceHistory PriceHistory[]

  @@index([supplierId, startedAt])
}

/// Завантажений файл прайсу — щоб можна було подивитись, з чого взялися ціни.
model PriceImportFile {
  id         String   @id @default(uuid())
  supplierId String
  fileName   String
  mimeType   String?
  sizeBytes  Int
  storedPath String
  uploadedAt DateTime @default(now())
  uploadedBy String?

  runs PriceImportRun[]

  @@index([supplierId, uploadedAt])
}

// ── доступ і журнал дій ─────────────────────────────────────────────

/// Разове посилання: запрошення (роль обирає адмін) або скидання пароля. У базі — лише SHA-256 токена.
model AccessLink {
  id          String         @id @default(uuid())
  kind        AccessLinkKind
  tokenHash   String         @unique
  /// Роль нового користувача (запрошення).
  role        UserRole?
  /// Для кого (підказка адміну): «Олена, закупівлі».
  note        String?
  /// Скидання — чий пароль; запрошення — хто зареєструвався.
  userId      String?
  createdById String
  createdAt   DateTime       @default(now())
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?

  @@index([kind, createdAt])
}

/// Журнал дій: хто, коли, що зробив (вхід, користувачі, налаштування, довідники, каталог).
model AuditEvent {
  id         BigInt   @id @default(autoincrement())
  at         DateTime @default(now())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  summary    String
  details    Json?

  @@index([at])
  @@index([entityType, entityId, at])
  @@index([userId, at])
}

// ── заявки (модуль 2) ────────────────────────────────────────────────
// Числа документа заявки — double precision: розрахунок (shared/pricing) іде в JS-числах, обмін із базою без перетворень.

/// Заявка: шапка, спосіб націнки, підсумки для реєстру. Рядки, блоки й пропозиції — окремими таблицями (зміни пишуться частинами).
model Request {
  id                 String        @id @default(uuid())
  number             Int           @unique
  requestDate        DateTime      @db.Date
  status             RequestStatus @default(in_progress)
  title              String?
  clientId           String?
  counterpartyId     String?
  contactId          String?
  ownCompanyId       String
  /// Відповідальний: той, хто створив або скопіював (можна змінити).
  managerId          String
  notes              String?
  purchaseNote       String?
  rateUsd            Float?
  rateEur            Float?
  ratesDate          DateTime?     @db.Date
  vatRatePct         Float
  /// Формула знижки від РРЦ на момент створення заявки (глобальна лишається пресетом для нових).
  discountFormula    String        @default("percent_off")
  kpSettings         Json
  approvalKpId       String?
  cancelReason       String?
  /// MarkupSettings заявки.
  markup             Json
  /// Зростає з кожним збереженням (захист від застарілих змін).
  version            Int           @default(1)
  linesCount         Int           @default(0)
  suppliersCount     Int           @default(0)
  totalPurchaseGross Float         @default(0)
  totalSaleNet       Float         @default(0)
  totalSaleGross     Float         @default(0)
  profitNet          Float         @default(0)
  approvedSaleGross  Float?
  kpCount            Int           @default(0)
  lastKpNumber       Int?
  lastKpFinal        Boolean?
  /// Завантажені файли (КП рахуються окремо).
  filesCount         Int           @default(0)
  sourceRequestId    String?
  copyInfo           Json?
  /// Номер, клієнт, контрагент, ЄДРПОУ, назва — для пошуку в реєстрі.
  searchText         String        @default("")
  createdAt          DateTime      @default(now())
  createdById        String?
  updatedAt          DateTime      @default(now())
  updatedById        String?

  lines       RequestLine[]
  blocks      RequestBlock[]
  offers      RequestOffer[]
  kps         KpDocument[]
  events      RequestEvent[]
  attachments RequestAttachment[]
  lock        RequestLock?

  @@index([status, number])
  @@index([managerId])
  @@index([clientId])
  @@index([requestDate])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "Request_searchText_trgm_idx")
}

model RequestLine {
  id               String  @id
  requestId        String
  request          Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  position         Int
  clientName       String
  clientUnit       String?
  qty              Float
  clientNote       String?
  selectionBlockId String?
  /// LineMarkupOverride.
  markup           Json
  approved         Boolean @default(false)
  approvedQty      Float?
  kpName           String?

  @@index([requestId])
}

model RequestBlock {
  id                String     @id
  requestId         String
  request           Request    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  position          Int
  supplierId        String?
  legalEntityId     String?
  defaultCurrency   Currency
  rateUsd           Float?
  rateEur           Float?
  rateSource        RatePolicy
  ratesDate         DateTime?  @db.Date
  supplierMarkupPct Float      @default(0)
  pricesIncludeVat  Boolean    @default(false)
  note              String?

  @@index([requestId])
}

/// Пропозиція (рядок × блок): знімок товару на момент підбору.
model RequestOffer {
  id               String       @id
  requestId        String
  request          Request      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  lineId           String
  blockId          String
  productId        String?
  sku              String?
  nameWork         String?
  name1c           String?
  nameKind         String       @default("work")
  unitCode         String?
  currency         Currency
  purchasePriceCur Float?
  rrpCur           Float?
  qty              Float?
  multiplicity     Float?
  noRounding       Boolean      @default(false)
  stockQty         Float?
  availability     Availability
  priceDate        DateTime?
  excluded         Boolean      @default(false)
  excludeReason    String?
  note             String?
  priceChange      Json?

  @@index([requestId])
  @@index([productId])
}

/// Сформоване КП: незмінний знімок (PDF і Excel будуються з нього).
model KpDocument {
  id           String    @id @default(uuid())
  requestId    String
  request      Request   @relation(fields: [requestId], references: [id], onDelete: Restrict)
  kpNumber     Int
  version      Int
  vatMode      String
  ownCompanyId String
  onlyApproved Boolean
  settings     Json
  totalNet     Float
  totalVat     Float
  totalGross   Float
  snapshot     Json
  sentAt       DateTime?
  createdAt    DateTime  @default(now())
  createdById  String?

  @@unique([requestId, version])
}

/// Історія заявки: хто, коли, що (сусідні дрібні зміни зливаються).
model RequestEvent {
  id        Int      @id @default(autoincrement())
  requestId String
  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  at        DateTime @default(now())
  userId    String?
  kind      String
  summary   String
  group     String?
  counts    Json?

  @@index([requestId, id])
}

/// Файли заявки (лист клієнта, його Excel тощо) — на диску в томі uploads, до 20 МБ.
model RequestAttachment {
  id               String   @id @default(uuid())
  requestId        String
  request          Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  kind             String   @default("client_request")
  originalFilename String
  mimeType         String
  sizeBytes        Int
  storagePath      String
  note             String?
  uploadedById     String?
  createdAt        DateTime @default(now())

  @@index([requestId])
}

/// Хто зараз редагує заявку (одна вкладка одного користувача); живе, поки приходить сигнал вкладки.
model RequestLock {
  requestId String   @id
  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    String
  sessionId String
  lockedAt  DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}
